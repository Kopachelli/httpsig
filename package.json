{
  "name": "httpsig-js",
  "version": "0.1.0",
  "description": "HTTP Message Signatures (RFC 9421) sign and verify for fetch Requests. WebCrypto-only, zero dependencies. The auth primitive the MCP authorization spec and agent-to-agent protocols are standardizing on.",
  "keywords": [
    "http-signatures",
    "rfc9421",
    "web-bot-auth",
    "mcp",
    "agents",
    "authentication"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kopachelli/httpsig-js.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}
